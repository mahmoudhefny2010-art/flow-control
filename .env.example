# Application
NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
JWT_EXPIRES_IN=12h

# Storage (leave blank to use the local JSON database in data/db.json)
MONGODB_URI=
DATA_FILE=

# Existing queue platform integration (blank uses the built-in development mock)
LEGACY_API_BASE=
LEGACY_API_KEY=mock-key

# Email (blank SMTP_HOST uses the development mail logger)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MIU QueueFlow <no-reply@miu.edu.eg>

# Optional Google OAuth sign-in. Set all three values to enable it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Queue behavior
PRIORITY_BOOST_MIN=45
CALL_TIMEOUT_MIN=5
QUEUE_ALERT_THRESHOLD=15
